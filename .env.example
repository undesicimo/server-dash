APP_NAME=Server Dash

# Optional: Homer dashboard config to import app groups from.
# Example:
# HOMER_CONFIG_URL=http://your-server.local:4001/assets/config.yml
HOMER_CONFIG_URL=

# Optional: backend health checks can use a different base host than public app links.
# This is useful when Homer links point to a VPN domain but the container should check LAN IPs.
# Example:
# APP_CHECK_BASE=http://192.168.1.10
APP_CHECK_BASE=

# Optional: frontend link rewriting.
# If the dashboard is opened from PUBLIC_TAILSCALE_HOST, links keep that hostname.
# Otherwise links are rewritten to PUBLIC_LAN_HOST while preserving each app's port/path.
# Examples:
# PUBLIC_LAN_HOST=192.168.1.10
# PUBLIC_TAILSCALE_HOST=server.example.ts.net
PUBLIC_LAN_HOST=
PUBLIC_TAILSCALE_HOST=
